  familyMeetingSchedule[monthKey] = details;
  drawFamilyCalendar();
};

function drawFamilyCalendar() {
  const firstDay = new Date(calendarYear, calendarMonth, 1).getDay();
  const daysInMonth = new Date(calendarYear, calendarMonth + 1, 0).getDate();
  const firstSaturday = 1 + (6 - firstDay + 7) % 7;

  const monthKey = calendarYear + "-" +
    String(calendarMonth + 1).padStart(2, "0");

 
const scheduleDate = familyMeetingSchedule[monthKey]?.date || "";
const parts = scheduleDate.split("-");

const scheduledDay =
  parts.length === 3 &&
  Number(parts[0]) === calendarYear &&
  Number(parts[1]) === calendarMonth + 1
    ? Number(parts[2])
    : null;

const override = changedMeetingDates[monthKey];

const meetingDay =
  Number.isInteger(scheduledDay) &&
  scheduledDay >= 1 &&
  scheduledDay <= daysInMonth
    ? scheduledDay
    : Number.isInteger(override) &&
      override >= 1 &&
      override <= daysInMonth
        ? override
        : firstSaturday;


  document.getElementById("calMonth").textContent =
    new Date(calendarYear, calendarMonth, 1)
      .toLocaleDateString("en-US", {
        month: "long", year: "numeric"
      });

  const grid = document.getElementById("calDays");
  grid.innerHTML = "";

  ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].forEach(day => {
    const cell = document.createElement("strong");
    cell.textContent = day;
    grid.appendChild(cell);
  });

  for (let i = 0; i < firstDay; i++) {
    grid.appendChild(document.createElement("span"));
  }

  for (let day = 1; day <= daysInMonth; day++) {
    const cell = document.createElement("div");
    cell.textContent = day;
    cell.style.cssText = "padding:10px 2px;border-radius:7px;";

    if (day === meetingDay) {
      cell.style.background = "#173f35";
      cell.style.color = "white";
      cell.style.fontWeight = "bold";
      cell.title = "Family Gathering";
    }

    grid.appendChild(cell);
  }

  document.getElementById("calMeeting").textContent =
    "Family Gathering: " +
    new Date(calendarYear, calendarMonth, meetingDay)
      .toLocaleDateString("en-US", {
        weekday: "long",
        month: "long",
        day: "numeric",
        year: "numeric"
      });
  
const schedule = familyMeetingSchedule[monthKey] || {};

const dateInput = document.getElementById("hostDate");
const timeInput = document.getElementById("hostTime");
const familySelect = document.getElementById("hostFamily");
const summary = document.getElementById("gatheringSummary");

